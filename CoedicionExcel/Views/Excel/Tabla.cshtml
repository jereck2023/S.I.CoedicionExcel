    async function iniciarEdicionEncabezado() {
        try {
            const response = await fetch('/Excel/IniciarEdicionEncabezado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    documentoId: documentoId,
                    usuario: usuario
                })
            });

            const data = await response.json();

            if (response.status === 409 && data.bloqueadoPorOtro) {
                alert(data.mensaje);
                return false;
            }

            if (!response.ok) {
                alert(data.mensaje || "No se pudo iniciar edición de encabezado");
                return false;
            }

             yoEditandoEncabezado = true;
             encabezadoBloqueado = true;
             encabezadoEditadoPor = usuario;
             actualizarEstadoVisualEncabezado();

            clearInterval(intervaloRenovacionEncabezado);
            intervaloRenovacionEncabezado = setInterval(() => {
                renovarEdicionEncabezado();
            }, 5000);

            return true;
        } catch (error) {
            console.error(error);
            return false;
        }
    }

    async function renovarEdicionEncabezado() {
        try {
            const response = await fetch('/Excel/RenovarEdicionEncabezado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    documentoId: documentoId,
                    usuario: usuario
                })
            });

            if (!response.ok) {
                clearInterval(intervaloRenovacionEncabezado);
                intervaloRenovacionEncabezado = null;
                yoEditandoEncabezado = false;
                encabezadoBloqueado = false;
                encabezadoEditadoPor = null;
                actualizarEstadoVisualEncabezado();
            }
        } catch (error) {
            console.error("Error renovando encabezado", error);
            clearInterval(intervaloRenovacionEncabezado);
            intervaloRenovacionEncabezado = null;
            yoEditandoEncabezado = false;
            encabezadoBloqueado = false;
            encabezadoEditadoPor = null;
            actualizarEstadoVisualEncabezado();
        }
    }

    async function liberarEdicionEncabezado() {
            if (!yoEditandoEncabezado) return;

            clearInterval(intervaloRenovacionEncabezado);
            intervaloRenovacionEncabezado = null;
            yoEditandoEncabezado = false;
            encabezadoBloqueado = false;
            encabezadoEditadoPor = null;
            actualizarEstadoVisualEncabezado();

        try {
            await fetch('/Excel/LiberarEdicionEncabezado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    documentoId: documentoId,
                    usuario: usuario
                })
            });
        } catch (error) {
            console.error(error);
        }
    }

