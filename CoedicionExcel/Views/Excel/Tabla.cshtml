    //OBTENER VERSIÓN INICIAL
    async function obtenerVersionInicial() {
        const response = await fetch(`/Excel/ObtenerVersionDocumento?documentoId=${documentoId}`);
        const data = await response.json();

        versionActual = data.version;
        console.log("Versión inicial:", versionActual);
    }

        function actualizarEstadoVisualEncabezado() {
        const divEstado = document.getElementById("estado-encabezado");
        if (!divEstado) return;

        if (!encabezadoBloqueado || !encabezadoEditadoPor) {
            divEstado.style.display = "none";
            divEstado.textContent = "";
            divEstado.style.backgroundColor = "";
            divEstado.style.color = "";
            return;
        }

        divEstado.style.display = "block";

        if (encabezadoEditadoPor === usuario) {
            divEstado.style.backgroundColor = "#e0ffe0";
            divEstado.style.color = "#1f4d1f";
            divEstado.textContent = `Estás editando un encabezado`;
        } else {
            divEstado.style.backgroundColor = "#ffe0e0";
            divEstado.style.color = "#7a1f1f";
            divEstado.textContent = `Encabezado en edición por ${encabezadoEditadoPor}`;
        }
    }

    //POLLING 🔁
        async function verificarCambios() {
        if (conflictoEnProceso) return;
        if (filaEnEdicionActual) return;
        if (yoEditandoEncabezado) return;

        try {
            await cargarSnapshot();
        } catch (error) {
            console.error("Error en polling:", error);
        }
    }

