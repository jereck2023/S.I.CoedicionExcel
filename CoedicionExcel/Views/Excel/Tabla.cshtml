            async function iniciarEdicionFila(filaId) {
                try {
                    const response = await fetch('/Excel/IniciarEdicionFila', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                        filaId: filaId,
                        usuario: usuario
                    })
                });

            const data = await response.json();

            if (response.status === 409 && data.bloqueadoPorOtro) {
                alert(data.mensaje);
                return false;
            }

            if (!response.ok) {
                alert(data.mensaje || "No se pudo iniciar edición");
                return false;
            }

            filaEnEdicionActual = filaId;

            // 🔁 Heartbeat cada 5s
            intervaloRenovacion = setInterval(() => {
                renovarEdicionFila(filaId);
            }, 5000);

            return true;

        } catch (error) {
            console.error(error);
            return false;
        }
    }

                async function renovarEdicionFila(filaId) {
        try {
            const response = await fetch('/Excel/RenovarEdicionFila', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    filaId: filaId,
                    usuario: usuario
                })
            });

            if (!response.ok) {
                clearInterval(intervaloRenovacion);
                intervaloRenovacion = null;
                filaEnEdicionActual = null;
                return;
            }

        } catch (error) {
            console.error("Error renovando edición", error);
            clearInterval(intervaloRenovacion);
            intervaloRenovacion = null;
            filaEnEdicionActual = null;
        }
    }

                async function liberarEdicionFila() {
        if (!filaEnEdicionActual) return;

        const filaIdALiberar = filaEnEdicionActual;

        clearInterval(intervaloRenovacion);
        intervaloRenovacion = null;
        filaEnEdicionActual = null;
        filaEditandoVisualmente = null;

        try {
            await fetch('/Excel/LiberarEdicionFila', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    filaId: filaIdALiberar,
                    usuario: usuario
                })
            });
        } catch (error) {
            console.error(error);
        }
    }

        async function cambiarFilaEnEdicion(nuevaFilaId) {
        if (filaEnEdicionActual && filaEnEdicionActual !== nuevaFilaId) {
            await liberarEdicionFila();
        }

        if (filaEnEdicionActual === nuevaFilaId) {
            return true;
        }

        const ok = await iniciarEdicionFila(nuevaFilaId);
        if (ok) {
            filaEditandoVisualmente = nuevaFilaId;
        }

        return ok;
    }

